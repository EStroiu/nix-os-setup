input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
    }
}

spawn-at-startup "noctalia"

hotkey-overlay {
}

binds {

    // Terminal

    Mod+Return hotkey-overlay-title="Open Terminal" {
        spawn "alacritty";
    }

    // Noctalia

    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }

    Mod+S hotkey-overlay-title="Control Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center";
    }

    Mod+Comma hotkey-overlay-title="Noctalia Settings" {
        spawn "noctalia" "msg" "settings-toggle";
    }

    Alt+Tab {
        spawn "noctalia" "msg" "window-switcher";
    }

    // Help
    Mod+Shift+Slash {
        show-hotkey-overlay;
    }

    // Close window
    Mod+Q {
        close-window;
    }

    // ----- Hardware -----

    XF86AudioRaiseVolume {
        spawn "noctalia" "msg" "volume-up";
    }

    XF86AudioLowerVolume {
        spawn "noctalia" "msg" "volume-down";
    }

    XF86AudioMute {
        spawn "noctalia" "msg" "volume-mute";
    }

    XF86MonBrightnessUp {
        spawn "noctalia" "msg" "brightness-up";
    }

    XF86MonBrightnessDown {
       spawn "noctalia" "msg" "brightness-down";
    }


    // ----- Focus -----

    Mod+Left {
        focus-column-left;
    }

    Mod+Right {
        focus-column-right;
    }

    Mod+Up {
        focus-window-up;
    }

    Mod+Down {
        focus-window-down;
    }

    // Vim-style alternatives
    Mod+H {
        focus-column-left;
    }

    Mod+L {
        focus-column-right;
    }

    Mod+K {
        focus-window-up;
    }

    Mod+J {
        focus-window-down;
    }

    // ----- Move windows / columns -----

    Mod+F hotkey-overlay-title="Maximize Column" {
        maximize-column;
    }

    Mod+Ctrl+Left {
        move-column-left;
    }

    Mod+Ctrl+Right {
        move-column-right;
    }

    Mod+Ctrl+Up {
        move-window-up;
    }

    Mod+Ctrl+Down {
        move-window-down;
    }

    Mod+Ctrl+H {
        move-column-left;
    }

    Mod+Ctrl+L {
        move-column-right;
    }

    Mod+Ctrl+K {
        move-window-up;
    }

    Mod+Ctrl+J {
        move-window-down;
    }

    // First / last column
    Mod+Home {
        focus-column-first;
    }

    Mod+End {
        focus-column-last;
    }

    Mod+Ctrl+Home {
        move-column-to-first;
    }

    Mod+Ctrl+End {
        move-column-to-last;
    }

    // ----- Workspaces -----

    Mod+Page_Down {
        focus-workspace-down;
    }

    Mod+Page_Up {
        focus-workspace-up;
    }

    Mod+U {
        focus-workspace-down;
    }

    Mod+I {
        focus-workspace-up;
    }

    Mod+Ctrl+Page_Down {
        move-column-to-workspace-down;
    }

    Mod+Ctrl+Page_Up {
        move-column-to-workspace-up;
    }

    Mod+Ctrl+U {
        move-column-to-workspace-down;
    }

    Mod+Ctrl+I {
        move-column-to-workspace-up;
    }

    // Direct workspace selection
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move current column to workspace
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ----- Multiple monitors -----

    Mod+Shift+Left {
        focus-monitor-left;
    }

    Mod+Shift+Right {
        focus-monitor-right;
    }

    Mod+Shift+Up {
        focus-monitor-up;
    }

    Mod+Shift+Down {
        focus-monitor-down;
    }

    Mod+Ctrl+Shift+Left {
        move-column-to-monitor-left;
    }

    Mod+Ctrl+Shift+Right {
        move-column-to-monitor-right;
    }

    Mod+Ctrl+Shift+Up {
        move-column-to-monitor-up;
    }

    Mod+Ctrl+Shift+Down {
        move-column-to-monitor-down;
    }

    // ----- Layout -----

    // Move windows into/out of columns
    Mod+BracketLeft {
        consume-or-expel-window-left;
    }

    Mod+BracketRight {
        consume-or-expel-window-right;
    }

    // Cycle preset column widths
    Mod+R {
        switch-preset-column-width;
    }

    // Center current column
    Mod+C {
        center-column;
    }

    // Width
    Mod+Minus {
        set-column-width "-10%";
    }

    Mod+Equal {
        set-column-width "+10%";
    }

    // Fullscreen
    Mod+Shift+F {
        fullscreen-window;
    }

    // Floating / tiled
    Mod+V {
        toggle-window-floating;
    }

    Mod+Shift+V {
        switch-focus-between-floating-and-tiling;
    }

    // Exit Niri
    Mod+Shift+E {
        quit;
    }
}
