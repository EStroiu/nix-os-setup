input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
    }
}


// ================================================================
// Layout
// ================================================================

layout {
    // Heights cycled by Super+Shift+R.
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}


spawn-at-startup "noctalia"

hotkey-overlay {
}


binds {
    // ============================================================
    // Applications / Noctalia
    // ============================================================

    Mod+Return hotkey-overlay-title="Open Terminal" {
        spawn "kitty";
    }

    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }

    Mod+S hotkey-overlay-title="Control Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center";
    }

    Mod+Shift+Comma hotkey-overlay-title="Noctalia Settings" {
        spawn "noctalia" "msg" "settings-toggle";
    }

    Alt+Tab hotkey-overlay-title="Window Switcher" {
        spawn "noctalia" "msg" "window-switcher";
    }


    // ============================================================
    // Niri UI
    // ============================================================

    Mod+Shift+Slash hotkey-overlay-title="Show Keyboard Shortcuts" {
        show-hotkey-overlay;
    }

    Mod+O repeat=false hotkey-overlay-title="Open / Close Overview" {
        toggle-overview;
    }

    Mod+Q repeat=false hotkey-overlay-title="Close Window" {
        close-window;
    }


    // ============================================================
    // Hardware
    // ============================================================

    XF86AudioRaiseVolume {
        spawn "noctalia" "msg" "volume-up";
    }

    XF86AudioLowerVolume {
        spawn "noctalia" "msg" "volume-down";
    }

    XF86AudioMute {
        spawn "noctalia" "msg" "volume-mute";
    }

    XF86MonBrightnessUp {
        spawn "noctalia" "msg" "brightness-up";
    }

    XF86MonBrightnessDown {
        spawn "noctalia" "msg" "brightness-down";
    }


    // ============================================================
    // Navigation inside the current workspace
    //
    // Super + Left/Right = move focus between columns
    // Super + Up/Down    = move focus between vertically stacked
    //                      windows inside the current column
    // ============================================================

    Mod+Left hotkey-overlay-title="Focus Column Left" {
        focus-column-left;
    }

    Mod+Right hotkey-overlay-title="Focus Column Right" {
        focus-column-right;
    }

    Mod+Up hotkey-overlay-title="Focus Window Above in Column" {
        focus-window-up;
    }

    Mod+Down hotkey-overlay-title="Focus Window Below in Column" {
        focus-window-down;
    }


    // ============================================================
    // Move columns / windows
    //
    // Super+Ctrl+Left/Right = move whole column
    // Super+Ctrl+Up/Down    = reorder stacked windows vertically
    // ============================================================

    Mod+Shift+H hotkey-overlay-title="Set Window Full Height" {
        set-window-height "100%";
    }

    Mod+Ctrl+Left hotkey-overlay-title="Move Column Left" {
        move-column-left;
    }

    Mod+Ctrl+Right hotkey-overlay-title="Move Column Right" {
        move-column-right;
    }

    Mod+Ctrl+Up hotkey-overlay-title="Move Window Up in Column" {
        move-window-up;
    }

    Mod+Ctrl+Down hotkey-overlay-title="Move Window Down in Column" {
        move-window-down;
    }


    // ============================================================
    // Stack multiple windows inside one column
    //
    // Super+, = consume window into current column
    // Super+. = expel window back into its own column
    // ============================================================

    Mod+Comma hotkey-overlay-title="Add Window to Current Column" {
        consume-window-into-column;
    }

    Mod+Period hotkey-overlay-title="Remove Window from Column" {
        expel-window-from-column;
    }


    // ============================================================
    // Window height
    //
    // Super+H          = immediately make selected window 50%
    // Super+Shift+Up   = increase height by 10%
    // Super+Shift+Down = decrease height by 10%
    // Super+Shift+R    = cycle 1/3 -> 1/2 -> 2/3
    // Super+Ctrl+R     = reset automatic height
    // ============================================================

    Mod+H hotkey-overlay-title="Set Window to Half Height" {
        set-window-height "50%";
    }

    Mod+Shift+Up hotkey-overlay-title="Make Window Taller" {
        set-window-height "+10%";
    }

    Mod+Shift+Down hotkey-overlay-title="Make Window Shorter" {
        set-window-height "-10%";
    }

    Mod+Shift+R hotkey-overlay-title="Cycle Window Height" {
        switch-preset-window-height;
    }

    Mod+Ctrl+R hotkey-overlay-title="Reset Window Height" {
        reset-window-height;
    }


    // ============================================================
    // Workspaces
    //
    // Alt separates workspace movement from movement inside
    // a stacked column.
    // ============================================================

    Mod+Alt+Up hotkey-overlay-title="Workspace Up" {
        focus-workspace-up;
    }

    Mod+Alt+Down hotkey-overlay-title="Workspace Down" {
        focus-workspace-down;
    }

    Mod+Ctrl+Alt+Up hotkey-overlay-title="Move Column to Workspace Up" {
        move-column-to-workspace-up;
    }

    Mod+Ctrl+Alt+Down hotkey-overlay-title="Move Column to Workspace Down" {
        move-column-to-workspace-down;
    }


    // Direct workspace selection

    Mod+1 {
        focus-workspace 1;
    }

    Mod+2 {
        focus-workspace 2;
    }

    Mod+3 {
        focus-workspace 3;
    }

    Mod+4 {
        focus-workspace 4;
    }

    Mod+5 {
        focus-workspace 5;
    }

    Mod+6 {
        focus-workspace 6;
    }

    Mod+7 {
        focus-workspace 7;
    }

    Mod+8 {
        focus-workspace 8;
    }

    Mod+9 {
        focus-workspace 9;
    }


    // Move the whole current column to a workspace

    Mod+Ctrl+1 {
        move-column-to-workspace 1;
    }

    Mod+Ctrl+2 {
        move-column-to-workspace 2;
    }

    Mod+Ctrl+3 {
        move-column-to-workspace 3;
    }

    Mod+Ctrl+4 {
        move-column-to-workspace 4;
    }

    Mod+Ctrl+5 {
        move-column-to-workspace 5;
    }

    Mod+Ctrl+6 {
        move-column-to-workspace 6;
    }

    Mod+Ctrl+7 {
        move-column-to-workspace 7;
    }

    Mod+Ctrl+8 {
        move-column-to-workspace 8;
    }

    Mod+Ctrl+9 {
        move-column-to-workspace 9;
    }


    // ============================================================
    // Multiple monitors
    //
    // Optimised for the common laptop setup where an external
    // monitor is to the left or right.
    // ============================================================

    Mod+Shift+Left hotkey-overlay-title="Focus Monitor Left" {
        focus-monitor-left;
    }

    Mod+Shift+Right hotkey-overlay-title="Focus Monitor Right" {
        focus-monitor-right;
    }

    Mod+Ctrl+Shift+Left hotkey-overlay-title="Move Column to Monitor Left" {
        move-column-to-monitor-left;
    }

    Mod+Ctrl+Shift+Right hotkey-overlay-title="Move Column to Monitor Right" {
        move-column-to-monitor-right;
    }


    // ============================================================
    // Column layout
    // ============================================================

    Mod+M hotkey-overlay-title="Maximize Window to Full Height" {
        maximize-window-to-edges;
    }

    Mod+F hotkey-overlay-title="Maximize Column" {
        maximize-column;
    }

    Mod+R hotkey-overlay-title="Cycle Column Width" {
        switch-preset-column-width;
    }

    Mod+C hotkey-overlay-title="Center Column" {
        center-column;
    }

    Mod+Minus hotkey-overlay-title="Make Column Narrower" {
        set-column-width "-10%";
    }

    Mod+Equal hotkey-overlay-title="Make Column Wider" {
        set-column-width "+10%";
    }


    // ============================================================
    // Fullscreen / floating
    // ============================================================

    Mod+Shift+F hotkey-overlay-title="Toggle Fullscreen" {
        fullscreen-window;
    }

    Mod+V hotkey-overlay-title="Toggle Floating Window" {
        toggle-window-floating;
    }

    Mod+Shift+V hotkey-overlay-title="Switch Floating / Tiled Focus" {
        switch-focus-between-floating-and-tiling;
    }


    // ============================================================
    // Session
    // ============================================================

    Mod+Shift+E hotkey-overlay-title="Exit Niri" {
        quit;
    }
}
