input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
    }
}


// ================================================================
// Startup
// ================================================================

spawn-at-startup "noctalia"


// ================================================================
// Screenshots
// ================================================================

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// ================================================================
// Hotkey help
// ================================================================

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}


binds {
    // ============================================================
    // Applications
    // ============================================================

    Mod+Return hotkey-overlay-title="Open Terminal" {
        spawn "kitty";
    }

    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }

    Mod+S hotkey-overlay-title="Control Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center";
    }

    Alt+Tab hotkey-overlay-title="Window Switcher" {
        spawn "noctalia" "msg" "window-switcher";
    }


    // ============================================================
    // Niri UI
    // ============================================================

    Mod+Shift+Slash hotkey-overlay-title="Show Keyboard Shortcuts" {
        show-hotkey-overlay;
    }

    Mod+O repeat=false hotkey-overlay-title="Overview" {
        toggle-overview;
    }

    Mod+Q repeat=false hotkey-overlay-title="Close Window" {
        close-window;
    }


    // ============================================================
    // Screenshots
    //
    // Print      = interactively select an area
    // Ctrl+Print = current monitor
    // Alt+Print  = current window
    // ============================================================

    Print hotkey-overlay-title="Screenshot Area" {
        screenshot show-pointer=false;
    }

    Ctrl+Print hotkey-overlay-title="Screenshot Monitor" {
        screenshot-screen show-pointer=false;
    }

    Alt+Print hotkey-overlay-title="Screenshot Window" {
        screenshot-window show-pointer=false;
    }


    // ============================================================
    // Hardware
    // ============================================================

    XF86AudioRaiseVolume {
        spawn "noctalia" "msg" "volume-up";
    }

    XF86AudioLowerVolume {
        spawn "noctalia" "msg" "volume-down";
    }

    XF86AudioMute {
        spawn "noctalia" "msg" "volume-mute";
    }

    XF86MonBrightnessUp {
        spawn "noctalia" "msg" "brightness-up";
    }

    XF86MonBrightnessDown {
        spawn "noctalia" "msg" "brightness-down";
    }


    // ============================================================
    // Focus
    //
    // Left / Right = neighbouring columns
    // Up / Down    = stacked windows inside current column
    // ============================================================

    Mod+Left hotkey-overlay-title="Focus Column Left" {
        focus-column-left;
    }

    Mod+Right hotkey-overlay-title="Focus Column Right" {
        focus-column-right;
    }

    Mod+Up hotkey-overlay-title="Focus Window Above" {
        focus-window-up;
    }

    Mod+Down hotkey-overlay-title="Focus Window Below" {
        focus-window-down;
    }


    // ============================================================
    // Move
    //
    // Ctrl+Left/Right = move whole column
    // Ctrl+Up/Down    = reorder windows inside a stacked column
    // ============================================================

    Mod+Ctrl+Left hotkey-overlay-title="Move Column Left" {
        move-column-left;
    }

    Mod+Ctrl+Right hotkey-overlay-title="Move Column Right" {
        move-column-right;
    }

    Mod+Ctrl+Up hotkey-overlay-title="Move Window Up" {
        move-window-up;
    }

    Mod+Ctrl+Down hotkey-overlay-title="Move Window Down" {
        move-window-down;
    }


    // ============================================================
    // Move windows between columns
    //
    // If the focused window is stacked with another window,
    // this expels it into its own column.
    //
    // If it is already alone, this consumes it into the
    // neighbouring column.
    // ============================================================

    Mod+Shift+Left hotkey-overlay-title="Move Window Into / Out Left" {
        consume-or-expel-window-left;
    }

    Mod+Shift+Right hotkey-overlay-title="Move Window Into / Out Right" {
        consume-or-expel-window-right;
    }


    // ============================================================
    // Window / column sizing
    //
    // H = Height
    // W = Width
    //
    // Super+H       = half height
    // Super+Shift+H = full height
    //
    // Super+W       = half width
    // Super+Shift+W = full width
    // ============================================================

    Mod+H hotkey-overlay-title="Half Height" {
        set-window-height "50%";
    }

    Mod+Shift+H hotkey-overlay-title="Full Height" {
        set-window-height "100%";
    }

    Mod+W hotkey-overlay-title="Half Width" {
        set-column-width "50%";
    }

    Mod+Shift+W hotkey-overlay-title="Full Width" {
        maximize-column;
    }


    // ============================================================
    // Workspaces
    //
    // Alt+Up/Down = navigate workspaces
    //
    // Ctrl+Alt+Up/Down = move the entire current column,
    // including vertically stacked windows, to another workspace.
    // ============================================================

    Mod+Alt+Up hotkey-overlay-title="Workspace Up" {
        focus-workspace-up;
    }

    Mod+Alt+Down hotkey-overlay-title="Workspace Down" {
        focus-workspace-down;
    }

    Mod+Ctrl+Alt+Up hotkey-overlay-title="Move Column to Workspace Up" {
        move-column-to-workspace-up;
    }

    Mod+Ctrl+Alt+Down hotkey-overlay-title="Move Column to Workspace Down" {
        move-column-to-workspace-down;
    }


    // ============================================================
    // Fullscreen
    // ============================================================

    Mod+F hotkey-overlay-title="Toggle Fullscreen" {
        fullscreen-window;
    }


    // ============================================================
    // Session
    // ============================================================

    Mod+Shift+E hotkey-overlay-title="Exit Niri" {
        quit;
    }
}
